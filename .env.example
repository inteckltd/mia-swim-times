# Required. Gates the whole app. Use a long random value.
APP_PASSCODE=

# Optional last resort. Leave empty. The app reads results in this order:
# 1. a SportSystems link saved on the Settings screen
# 2. the meet linked from https://www.swimwarriors.org.uk/liveresults
# 3. this address, or the usual Warriors index if this is empty
# The club replaces the files at that index for each new meet.
RESULTS_INDEX_URL=

# One-time setup so Settings can save a results link. The app cannot write
# Vercel env vars, so the link is stored in Upstash Redis (the store behind
# Vercel KV). In the Vercel project open Storage or Marketplace, create an
# Upstash Redis database, and connect it to this project. The integration
# sets the two variables below. Redeploy once. The older names
# KV_REST_API_URL and KV_REST_API_TOKEN are also accepted.
# Leave these empty if you are not saving a link. Times still load.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SC for a 25m pool, LC for a 50m pool. Warriors home meets at Orford Jubilee
# are short course, including Percy Mason 2026.
MEET_COURSE=SC

# Optional. The app tries this for entry times. Warrington's Swim Manager
# meet page currently redirects to a club login, so entry times fall back
# to the SportSystems start lists. Set it empty to skip the request.
SWIMMANAGER_MEET_URL=https://warringtonw.swimmanager.co.uk/meets/252367

# Swimmer. The biography page is checked against this name and membership.
SWIMMER_NAME=Mia Clarke
SWIMMER_MEMBERSHIP=1820449
SWIMMER_CLUB_MATCH=Warrington
# Used only if the biography page does not include a year of birth.
SWIMMER_YEAR_OF_BIRTH=2016
SWIMMER_GENDER=female

# Rankings use Swim England's last-12-months lists, age at this date.
# 31/12/2026 is age 10 for a 2016 birth year. That is the same girls as
# age 11 at 31/12/2027, which is what the 2027 qualifying times use.
RANKINGS_AGE_AT=31/12/2026
# How long a rankings page is cached, in seconds. Minimum 300.
RANKINGS_REVALIDATE_SECONDS=3600

# How long gala pages are cached, in seconds. Kept between 2 and 5 minutes
# so a result posted during the session shows up on the next open. Refresh
# skips this cache.
REVALIDATE_SECONDS=120
